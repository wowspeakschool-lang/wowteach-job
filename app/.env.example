# Ничего секретного здесь нет и быть не может: всё, что попадает в бандл Vite,
# публично по определению — ровно как сейчас в боевых html. Настоящие
# ограничения доступа живут в RLS и в SECURITY DEFINER-функциях.

# Цепочка хостов через запятую. Первый — основной, остальные запасные.
VITE_SUPABASE_HOSTS=https://api.wowteach.ru,https://api2.wowteach.ru,https://vtcxghsqymwkyiogpndf.supabase.co

# Публикуемый ключ (sb_publishable_…)
VITE_SUPABASE_KEY=

# Префикс ключей сессии. В проде ПУСТО — иначе персонал разлогинится.
# На staging задать (например beta-), чтобы не перетирать боевую сессию
# на том же домене .wowteach.ru.
VITE_AUTH_STORAGE_PREFIX=

VITE_APP_ENV=development

# Куда возвращает magic link кабинета кандидата.
VITE_CABINET_REDIRECT_URL=http://localhost:5173/
